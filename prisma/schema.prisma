generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String?
  timezone    String   @default("America/Sao_Paulo")
  /// Como os textos tratam a pessoa: "masculino" (mano), "feminino" (mina) ou "neutro"
  addressAs   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections     ProviderConnection[]
  listeningEvents ListeningEvent[]
  sessions        RecommendationSession[]
  feedbacks       RecommendationFeedback[]
  aiRuns          AIAnalysisRun[]
  playlistExports PlaylistExport[]
  appSessions     AppSession[]
}

model AppSession {
  tokenHash         String   @id
  userId            String
  credentialVersion String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Shared across application instances: serverless restarts do not reset login limits.
model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ProviderConnection {
  id               String    @id @default(uuid())
  userId           String
  provider         String
  username         String
  status           String    @default("ACTIVE")
  encryptedTokens  String?
  lastSyncedAt     DateTime?
  historicalCursor String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@unique([userId, provider])
}

model SyncRun {
  id               String    @id @default(uuid())
  connectionId     String
  type             String
  status           String
  cursor           String?
  fetchedCount     Int       @default(0)
  insertedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
}

model Artist {
  id             String    @id @default(uuid())
  name           String
  normalizedName String
  mbid           String?
  country        String?
  type           String?
  disambiguation String?
  tags           String?
  metadataStatus String    @default("UNRESOLVED")
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tracks          Track[]
  albums          Album[]
  listeningEvents ListeningEvent[]

  @@index([normalizedName])
  @@index([metadataStatus])
}

model Track {
  id             String    @id @default(uuid())
  artistId       String
  name           String
  normalizedName String
  durationMs     Int?
  mbid           String?
  /// Prévia de 30s do catálogo da Apple
  previewUrl     String?
  itunesTrackId  String?
  appleMusicUrl  String?
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  listeningEvents ListeningEvent[]

  @@index([artistId, normalizedName])
}

model Album {
  id             String    @id @default(uuid())
  artistId       String
  name           String
  normalizedName String
  releaseYear    Int?
  primaryType    String?
  mbid           String?
  releaseGroupMbid String?
  releaseGroupFetchedAt DateTime?
  coverUrl       String?
  coverSource    String?
  coverEntityType String?
  coverMbid      String?
  coverFetchedAt DateTime?
  /// Vínculo com o catálogo da Apple: com ele as próximas consultas vão direto, sem busca por nome
  itunesCollectionId String?
  appleMusicUrl  String?
  /// Gênero do catálogo da Apple, normalizado — reserva quando o artista não tem tags
  itunesGenre    String?
  itunesFetchedAt DateTime?
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  listeningEvents ListeningEvent[]

  @@index([artistId, normalizedName])
  @@index([coverFetchedAt])
  @@index([releaseGroupMbid])
  @@index([releaseGroupFetchedAt])
  @@index([itunesFetchedAt])
}

model ListeningEvent {
  id               String   @id @default(uuid())
  userId           String
  playedAt         DateTime
  provider         String
  providerEventKey String
  rawArtistName    String
  rawTrackName     String
  rawAlbumName     String?
  artistId         String?
  trackId          String?
  albumId          String?
  createdAt        DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  track  Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, providerEventKey])
  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, artistId, playedAt])
  @@index([userId, trackId, playedAt])
}

model RecommendationSession {
  id               String   @id @default(uuid())
  userId           String
  mode             String
  context          String?
  profilePeriod    String   @default("30d")
  algorithmVersion String   @default("v1")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   RecommendationItem[]
  exports PlaylistExport[]

  @@index([userId, createdAt(sort: Desc)])
}

model RecommendationItem {
  id              String  @id @default(uuid())
  sessionId       String
  artistName      String
  trackName       String
  albumName       String?
  genre           String?
  score           Float
  noveltyScore    Float?
  scoreComponents Json?
  rank            Int
  status          String  @default("PENDING")
  reason          String?
  artistId        String?
  trackId         String?
  coverUrl        String?
  previewUrl      String?
  appleMusicUrl   String?
  createdAt       DateTime @default(now())

  session  RecommendationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback RecommendationFeedback[]

  @@index([sessionId, rank])
}

model RecommendationFeedback {
  id        String   @id @default(uuid())
  itemId    String
  userId    String
  type      String
  note      String?
  createdAt DateTime @default(now())

  item RecommendationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([itemId])
}

model AIAnalysisRun {
  id              String   @id @default(uuid())
  userId          String
  kind            String
  provider        String   @default("gemini")
  model           String?
  promptVersion   String   @default("v1")
  inputHash       String?
  validatedOutput Json?
  rawOutput       String?
  status          String   @default("PENDING")
  tokenCount      Int?
  errorMessage    String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([inputHash])
}

model PlaylistExport {
  id                 String   @id @default(uuid())
  sessionId          String
  userId             String
  providerPlaylistId String?
  playlistUrl        String?
  mode               String
  selectedItemIds    Json?
  totalItems         Int      @default(0)
  resolvedCount      Int      @default(0)
  createdAt          DateTime @default(now())

  session RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
