# Required core infrastructure
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Acesso pessoal. Gere com: node scripts/setup-auth.mjs
# Em produção, APP_ORIGIN deve ser a origem HTTPS exata do site, sem caminho.
AUTH_USER_ID=""
AUTH_PASSWORD_HASH=""
APP_ORIGIN="http://127.0.0.1:3000"

# Required only when Last.fm synchronization is enabled
LASTFM_API_KEY=""
LASTFM_USER_AGENT="Arcadium/0.1 (seu-email@dominio.com)"

# Optional metadata enrichment
MUSICBRAINZ_USER_AGENT="Arcadium/0.1 (seu-email@dominio.com)"

# Optional AI narrative; the application uses a deterministic fallback without it
GEMINI_API_KEY=""
AI_MODEL="gemini-3.5-flash"

# Recommended for scheduled synchronization in production
CRON_SECRET=""

NODE_ENV="development"

# Exportação de playlists para o Spotify (opcional)
# Crie um app em https://developer.spotify.com/dashboard e cadastre o Redirect URI abaixo.
# O Spotify não aceita mais "localhost": use o IP de loopback, e navegue no app
# por 127.0.0.1 também, senão o cookie de estado do OAuth não volta.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"

# Cifra os tokens de provedor guardados no banco. Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Teto de chamadas à IA. O free tier do Gemini dá 20/dia por modelo;
# o padrão usa 60% disso e guarda o resto de reserva.
AI_DAILY_LIMIT="12"
AI_HOURLY_LIMIT="3"
